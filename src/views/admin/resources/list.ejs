<% layout('layout') %>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h3 class="mb-1">Resources</h3>
    <div class="text-muted small">
      <span class="badge rounded-pill text-bg-light border"><%= resources.length %></span>
      item<%= resources.length === 1 ? '' : 's' %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-sm btn-outline-success" href="/admin">
      <i class="bi bi-speedometer2"></i> Dashboard
    </a>
    <a class="btn btn-sm btn-success" href="/repository/upload">
      <i class="bi bi-upload"></i> Upload
    </a>
  </div>
</div>

<!-- Card + Table -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white">
    <div class="d-flex align-items-center justify-content-between">
      <span class="fw-semibold">All Resources</span>
      <span class="text-muted small">Newest first</span>
    </div>
  </div>

  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-light">
          <tr class="small text-uppercase text-muted">
            <th style="min-width: 20rem;">Title</th>
            <th>Category</th>
            <th>Type</th>
            <th class="text-center">Downloads</th>
            <th>Added</th>
            <th style="min-width: 14rem;" class="text-end">Actions</th>
          </tr>
        </thead>

        <tbody>
          <% if (!resources.length) { %>
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                <i class="bi bi-archive me-1"></i> No resources yet.
              </td>
            </tr>
          <% } %>

          <% (resources || []).forEach((r, idx) => {
               const catName = (r && r.ResourceCategory && r.ResourceCategory.name) ? r.ResourceCategory.name : 'Uncategorized';
               const type = (r && r.fileType) ? r.fileType : 'OTHER';
               const typeClass = (type === 'PDF') ? 'text-bg-danger'
                               : (type === 'AUDIO') ? 'text-bg-info'
                               : (type === 'VIDEO') ? 'text-bg-warning'
                               : 'text-bg-secondary';
               const delId = `delResourceModal-${r && r.id}-${idx}`;
               const descId = `desc-${r && r.id}-${idx}`;
          %>
            <tr>
              <!-- Title -->
              <td class="fw-semibold">
                <div class="d-flex align-items-start justify-content-between">
                  <div style="flex:1;">
                    <div class="text-truncate" style="max-width: 36ch;"><%= (r && r.title) || 'Untitled' %></div>
                    <% if (r && r.description) { %>
                      <div id="<%= descId %>" class="small text-muted text-truncate" style="max-width: 50ch;">
                        <%= r.description %>
                      </div>
                    <% } %>
                  </div>
                  <% if (r && r.description) { %>
                    <button type="button"
                            class="btn btn-sm btn-outline-secondary ms-2 toggle-desc"
                            data-target="#<%= descId %>">
                      <i class="bi bi-eye"></i>
                    </button>
                  <% } %>
                </div>
              </td>

              <!-- Category -->
              <td>
                <span class="badge text-bg-light border">
                  <i class="bi bi-tag me-1"></i><%= catName %>
                </span>
              </td>

              <!-- Type -->
              <td>
                <span class="badge <%= typeClass %>"><%= type %></span>
              </td>

              <!-- Downloads -->
              <td class="text-center">
                <span class="text-muted"><i class="bi bi-cloud-arrow-down me-1"></i></span>
                <%= (r && typeof r.downloads === 'number') ? r.downloads.toLocaleString() : 0 %>
              </td>

              <!-- Created date -->
              <td class="small text-muted">
                <%= new Date((r && r.createdAt) || Date.now()).toLocaleString() %>
              </td>

              <!-- Actions -->
              <td class="text-end">
                <div class="d-inline-flex flex-wrap gap-2">
                  <!-- Download -->
                  <a class="btn btn-sm btn-outline-success"
                     href="/repository/<%= r && r.id %>/download">
                    <i class="bi bi-download"></i> Download
                  </a>

                  <!-- Delete -->
                  <form method="post"
                        action="/admin/resources/<%= r && r.id %>/delete"
                        onsubmit="return confirm('Delete resource “<%= r.title %>”?');">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                    <button class="btn btn-sm btn-danger">
                      <i class="bi bi-trash-fill"></i> Delete
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Toggle show/hide description
  document.addEventListener('click', function (e) {
    if (e.target.closest('.toggle-desc')) {
      const btn = e.target.closest('.toggle-desc');
      const target = document.querySelector(btn.dataset.target);
      if (target) {
        target.classList.toggle('text-truncate');
        const icon = btn.querySelector('i');
        if (icon) {
          icon.classList.toggle('bi-eye');
          icon.classList.toggle('bi-eye-slash');
        }
      }
    }
  });
</script>
