<% layout('layout') %>

<!-- Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h3 class="mb-1">RBAC: User Roles</h3>
    <div class="text-muted small">
      <%= users.length %> user<%= users.length === 1 ? '' : 's' %> •
      <%= roles.length %> role<%= roles.length === 1 ? '' : 's' %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-sm btn-outline-secondary" href="/admin">
      <i class="bi bi-speedometer2"></i> Dashboard
    </a>
    <a class="btn btn-sm btn-outline-success" href="/admin/users">
      <i class="bi bi-people"></i> Users
    </a>
  </div>
</div>

<!-- (Optional) Quick filter -->
<form method="get" class="row g-3 align-items-end mb-3">
  <div class="col-md-6 col-lg-5">
    <label class="form-label mb-1 small text-muted">Search Users</label>
    <input class="form-control" type="search" name="q" placeholder="Username or email…" value="<%= q || '' %>">
  </div>
  <div class="col-auto">
    <button class="btn btn-outline-success">
      <i class="bi bi-search"></i> Search
    </button>
  </div>
  <% if (q) { %>
    <div class="col-auto">
      <a class="btn btn-outline-success" href="/admin/rbac/users">
        <i class="bi bi-x-circle"></i> Clear
      </a>
    </div>
  <% } %>
</form>

<!-- Table -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-light">
          <tr class="small text-uppercase text-muted">
            <th style="min-width: 14rem;">User</th>
            <th>Email</th>
            <th style="min-width: 16rem;">Current Roles</th>
            <th style="min-width: 22rem;">Assign / Remove</th>
          </tr>
        </thead>
        <tbody>
          <% if (!users.length) { %>
            <tr>
              <td colspan="4" class="text-center py-5 text-muted">
                <i class="bi bi-person-dash me-1"></i> No users found.
              </td>
            </tr>
          <% } %>

          <% users.forEach(u => { %>
            <tr>
              <!-- User -->
              <td>
                <div class="d-flex align-items-center gap-2">
                  <span class="rounded-circle bg-primary bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center"
                        style="width:34px;height:34px;">
                    <span class="small fw-semibold"><%= (u.username || 'U').slice(0,1).toUpperCase() %></span>
                  </span>
                  <div>
                    <div class="fw-semibold"><%= u.username %></div>
                    <% if (u.isSuperuser) { %>
                      <span class="badge text-bg-warning text-dark">Superuser</span>
                    <% } %>
                  </div>
                </div>
              </td>

              <!-- Email -->
              <td class="text-muted small"><%= u.email %></td>

              <!-- Current roles -->
              <td>
                <div class="d-flex flex-wrap gap-1">
                  <% if (u.Roles && u.Roles.length) { %>
                    <% u.Roles.forEach(r => { %>
                      <span class="badge text-bg-light border">
                        <i class="bi bi-shield-check me-1"></i><%= r.name %>
                      </span>
                    <% }) %>
                  <% } else { %>
                    <span class="text-muted small">none</span>
                  <% } %>
                </div>
              </td>

              <!-- Assign / Remove -->
              <td>
                <div class="d-flex flex-wrap gap-2">
                  <% roles.forEach(r => { 
                       const has = !!u.Roles?.some(x => x.id === r.id);
                  %>
                    <form method="post" action="/admin/rbac/users/<%= u.id %>/role" class="d-inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                      <input type="hidden" name="roleId" value="<%= r.id %>"/>
                      <input type="hidden" name="action" value="<%= has ? 'remove' : 'add' %>"/>
                      <button class="btn btn-sm <%= has ? 'btn-outline-danger' : 'btn-outline-success' %>"
                              data-bs-toggle="tooltip"
                              data-bs-title="<%= has ? ('Remove ' + r.name) : ('Add ' + r.name) %>">
                        <i class="bi <%= has ? 'bi-dash-circle' : 'bi-plus-circle' %>"></i>
                        <span class="d-none d-sm-inline"><%= has ? 'Remove' : 'Add' %> <%= r.name %></span>
                      </button>
                    </form>
                  <% }) %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // Enable tooltips on action buttons
  document.addEventListener('DOMContentLoaded', function () {
    var t = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    t.forEach(function (el) { new bootstrap.Tooltip(el); });
  });
</script>