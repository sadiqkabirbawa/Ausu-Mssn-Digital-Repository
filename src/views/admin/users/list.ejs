<% layout('layout') %>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h3 class="mb-0">Users</h3>
    <div class="text-muted small">
      <%= users.length %> user<%= users.length === 1 ? '' : 's' %><% if (q) { %> • search: “<%= q %>”<% } %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <a class="btn btn-outline-success btn-sm" href="/admin">Dashboard</a>
    <a class="btn btn-outline-success btn-sm" href="/admin/rbac/users">Assign Roles</a>
    <a class="btn btn-success btn-sm" href="/admin/users/new">New User</a>
  </div>
</div>

<!-- Search -->
<form method="get" class="row g-2 align-items-end mb-3">
  <div class="col-md-6 col-lg-5">
    <label class="form-label mb-1 small text-muted">Search</label>
    <input class="form-control" type="search" placeholder="Username, email, or name…" name="q" value="<%= q || '' %>">
  </div>
  <div class="col-auto">
    <button class="btn btn-outline-success">Search</button>
  </div>
  <% if (q) { %>
  <div class="col-auto">
    <a class="btn btn-outline-success" href="/admin/users">Clear</a>
  </div>
  <% } %>
</form>

<!-- Users table -->
<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead class="table-light">
      <tr class="small text-uppercase text-muted">
        <th>Username</th>
        <th>Email</th>
        <th>Name</th>
        <th>Legacy Role</th>
        <th>Joined</th>
        <th style="min-width: 26rem;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!users.length) { %>
        <tr>
          <td colspan="6" class="text-center py-5 text-muted">
            No users found.
          </td>
        </tr>
      <% } %>

      <% users.forEach(u => { %>
        <tr>
          <td class="fw-semibold"><%= u.username %></td>
          <td><%= u.email %></td>
          <td><%= [u.firstName, u.lastName].filter(Boolean).join(' ') || '—' %></td>
          <td><span class="badge text-bg-secondary"><%= u.role || 'MEMBER' %></span></td>
          <td><%= new Date(u.createdAt).toLocaleString() %></td>

          <td>
            <div class="d-flex flex-wrap gap-2">
              <!-- Update role -->
              <form method="post" action="/admin/users/<%= u.id %>/role" class="d-flex gap-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                <select class="form-select form-select-sm" name="role" aria-label="Set legacy role">
                  <option value="MEMBER"    <%= u.role==='MEMBER'    ? 'selected' : '' %>>MEMBER</option>
                  <option value="EXECUTIVE" <%= u.role==='EXECUTIVE' ? 'selected' : '' %>>EXECUTIVE</option>
                  <option value="ADMIN"     <%= u.role==='ADMIN'     ? 'selected' : '' %>>ADMIN</option>
                </select>
                <button class="btn btn-sm btn-success">
                  <i class="bi bi-pencil-square"></i> Update
                </button>
              </form>

              <!-- Reset password -->
              <form method="post" action="/admin/users/<%= u.id %>/password" class="d-flex gap-2">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                <input type="text" class="form-control form-control-sm" name="password" placeholder="new password" aria-label="New password">
                <button class="btn btn-sm btn-success text-white">
                  <i class="bi bi-key"></i> Reset
                </button>
              </form>

              <!-- Delete user -->
              <form method="post" action="/admin/users/<%= u.id %>/delete"
                    onsubmit="return confirm('Delete user <%= u.username %>?');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>
                <button class="btn btn-sm btn-danger">
                  <i class="bi bi-trash"></i> Delete
                </button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>