<% layout('layout') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <h3 class="mb-0">Donate</h3>
  <a href="/" class="btn btn-sm btn-outline-secondary">
    <i class="bi bi-arrow-left"></i> Back Home
  </a>
</div>

<div class="row g-4">
  <!-- Donation Form -->
  <div class="col-lg-6">
    <div class="card shadow-sm border-0">
      <div class="card-body p-4">
        <h5 class="mb-3">Support Our Mission</h5>
        <p class="text-muted small">
          Your donations help us maintain resources, fund activities, and support the community.  
          Every contribution counts — thank you!
        </p>

        <form method="post" action="/donations/init" class="row g-3">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"/>

          <div class="col-md-6">
            <label class="form-label">Full Name <span class="text-danger">*</span></label>
            <input name="fullName" class="form-control" placeholder="e.g. Abba Haruna" required>
          </div>

          <div class="col-md-6">
            <label class="form-label">Email <span class="text-danger">*</span></label>
            <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
          </div>

          <div class="col-md-12">
            <label class="form-label">Amount (₦)</label>
            <input type="number" name="amount" min="100" class="form-control" placeholder="Min ₦100" required>
            <div class="form-text">Minimum donation: ₦100</div>
          </div>

          <div class="col-12">
            <button class="btn btn-success w-100">
              <i class="bi bi-credit-card-2-front me-1"></i> Proceed to Paystack
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Recent Donations -->
  <div class="col-lg-6">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-body p-4">
        <h5 class="mb-3">Recent Successful Donations</h5>
        <div class="table-responsive">
          <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light small text-muted text-uppercase">
              <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% if (donations.length === 0) { %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">
                    <i class="bi bi-emoji-frown fs-5 me-1"></i> No donations yet.
                  </td>
                </tr>
              <% } %>

              <% donations.forEach(d => { %>
                <tr>
                  <td><%= d.fullName %></td>
                  <td class="text-muted small"><%= d.email %></td>
                  <td>₦<%= d.amount.toLocaleString() %></td>
                  <td>
                    <span class="badge text-bg-success">
                      <i class="bi bi-check-circle me-1"></i> <%= d.status %>
                    </span>
                  </td>
                  <td class="small"><%= new Date(d.createdAt).toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>