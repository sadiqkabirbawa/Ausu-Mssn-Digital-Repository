<% layout('layout') %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h3 class="mb-1">Notifications</h3>
    <div class="text-muted small">
      <% if (unreadCount > 0) { %>
        <%= unreadCount %> unread notification<%= unreadCount === 1 ? '' : 's' %>
      <% } else { %>
        All caught up!
      <% } %>
    </div>
  </div>
  <div class="d-flex gap-2">
    <% if (unreadCount > 0) { %>
      <button class="btn btn-sm btn-outline-success" onclick="markAllAsRead()">
        <i class="bi bi-check-all me-1"></i> Mark All Read
      </button>
    <% } %>
    <a class="btn btn-sm btn-outline-secondary" href="/">Home</a>
  </div>
</div>

<!-- Filter Tabs -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-0">
    <ul class="nav nav-tabs nav-tabs-custom" role="tablist">
      <li class="nav-item">
        <a class="nav-link <%= !filters.unread ? 'active' : '' %>" href="/notifications">
          <i class="bi bi-list me-1"></i> All Notifications
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link <%= filters.unread ? 'active' : '' %>" href="/notifications?unread=true">
          <i class="bi bi-circle-fill me-1"></i> Unread Only
          <% if (unreadCount > 0) { %>
            <span class="badge bg-danger ms-1"><%= unreadCount %></span>
          <% } %>
        </a>
      </li>
    </ul>
  </div>
</div>

<!-- Notifications List -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (notifications.length === 0) { %>
      <div class="text-center py-5">
        <div class="text-muted mb-3">
          <i class="bi bi-bell-slash" style="font-size: 3rem;"></i>
        </div>
        <h5 class="text-muted">No notifications</h5>
        <p class="text-muted small">
          <% if (filters.unread) { %>
            You're all caught up! No unread notifications.
          <% } else { %>
            You don't have any notifications yet.
          <% } %>
        </p>
      </div>
    <% } else { %>
      <div class="list-group list-group-flush">
        <% notifications.forEach(notification => { %>
          <div class="list-group-item <%= !notification.read ? 'bg-light' : '' %>" data-notification-id="<%= notification.id %>">
            <div class="d-flex align-items-start gap-3">
              <!-- Notification Icon -->
              <div class="flex-shrink-0">
                <% if (!notification.read) { %>
                  <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <% if (notification.type === 'SUCCESS') { %>
                      <i class="bi bi-check-circle-fill"></i>
                    <% } else if (notification.type === 'WARNING') { %>
                      <i class="bi bi-exclamation-triangle-fill"></i>
                    <% } else if (notification.type === 'ERROR') { %>
                      <i class="bi bi-x-circle-fill"></i>
                    <% } else if (notification.type === 'ANNOUNCEMENT') { %>
                      <i class="bi bi-megaphone-fill"></i>
                    <% } else if (notification.type === 'RESOURCE_UPLOADED') { %>
                      <i class="bi bi-cloud-arrow-up-fill"></i>
                    <% } else if (notification.type === 'DONATION_RECEIVED') { %>
                      <i class="bi bi-heart-fill"></i>
                    <% } else { %>
                      <i class="bi bi-info-circle-fill"></i>
                    <% } %>
                  </div>
                <% } else { %>
                  <div class="text-muted rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <% if (notification.type === 'SUCCESS') { %>
                      <i class="bi bi-check-circle"></i>
                    <% } else if (notification.type === 'WARNING') { %>
                      <i class="bi bi-exclamation-triangle"></i>
                    <% } else if (notification.type === 'ERROR') { %>
                      <i class="bi bi-x-circle"></i>
                    <% } else if (notification.type === 'ANNOUNCEMENT') { %>
                      <i class="bi bi-megaphone"></i>
                    <% } else if (notification.type === 'RESOURCE_UPLOADED') { %>
                      <i class="bi bi-cloud-arrow-up"></i>
                    <% } else if (notification.type === 'DONATION_RECEIVED') { %>
                      <i class="bi bi-heart"></i>
                    <% } else { %>
                      <i class="bi bi-info-circle"></i>
                    <% } %>
                  </div>
                <% } %>
              </div>

              <!-- Notification Content -->
              <div class="flex-grow-1">
                <div class="d-flex align-items-start justify-content-between">
                  <div>
                    <h6 class="mb-1 <%= !notification.read ? 'fw-semibold' : '' %>">
                      <%= notification.title %>
                    </h6>
                    <p class="mb-1 text-muted small">
                      <%= notification.message %>
                    </p>
                    <div class="text-muted small">
                      <i class="bi bi-clock me-1"></i>
                      <%= new Date(notification.createdAt).toLocaleString() %>
                    </div>
                  </div>
                  
                  <!-- Action Button -->
                  <% if (notification.actionUrl) { %>
                    <div class="flex-shrink-0 ms-3">
                      <a href="<%= notification.actionUrl %>" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-arrow-right"></i>
                      </a>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- Pagination -->
<% if (pagination && (pagination.hasNextPage || pagination.hasPrevPage)) { %>
  <nav aria-label="Notification pagination" class="mt-4">
    <ul class="pagination justify-content-center">
      <% if (pagination.hasPrevPage) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= pagination.prevPage %><%= filters.unread ? '&unread=true' : '' %>">
            <i class="bi bi-chevron-left"></i> Previous
          </a>
        </li>
      <% } %>
      
      <% if (pagination.hasNextPage) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= pagination.nextPage %><%= filters.unread ? '&unread=true' : '' %>">
            Next <i class="bi bi-chevron-right"></i>
          </a>
        </li>
      <% } %>
    </ul>
  </nav>
<% } %>

<script>
  async function markAllAsRead() {
    try {
      const response = await fetch('/notifications/mark-all-read', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        }
      });
      
      if (response.ok) {
        location.reload();
      } else {
        alert('Failed to mark all notifications as read');
      }
    } catch (error) {
      console.error('Error:', error);
      alert('An error occurred');
    }
  }

  // Auto-mark as read when clicking on notification
  document.addEventListener('click', async (e) => {
    const notificationItem = e.target.closest('[data-notification-id]');
    if (notificationItem) {
      const notificationId = notificationItem.dataset.notificationId;
      const isUnread = notificationItem.classList.contains('bg-light');
      
      if (isUnread) {
        try {
          await fetch(`/notifications/${notificationId}/read`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            }
          });
          
          // Remove unread styling
          notificationItem.classList.remove('bg-light');
          const icon = notificationItem.querySelector('.bg-primary');
          if (icon) {
            icon.classList.remove('bg-primary', 'bg-opacity-10', 'text-primary');
            icon.classList.add('text-muted');
          }
        } catch (error) {
          console.error('Error marking notification as read:', error);
        }
      }
    }
  });
</script>
